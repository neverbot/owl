{
  "title": "Owl Runtime",
  "uid": "owl-runtime",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Goroutines",
      "description": "Number of live goroutines in the Owl process",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "owl_runtime_goroutines",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Heap Allocated",
      "description": "Bytes allocated and not yet freed on the Go heap",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "owl_runtime_alloc_bytes",
          "legendFormat": "alloc"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "GC Pause (total ms)",
      "description": "Cumulative GC pause time in milliseconds",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "owl_runtime_gc_pause_total_ms",
          "legendFormat": "gc pause"
        }
      ]
    }
  ]
}
